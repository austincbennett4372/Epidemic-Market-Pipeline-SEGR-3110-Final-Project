run_full_pipeline <- function(series_or_mat,
                              dataset_name,
                              train_frac        = 0.80,
                              batch_size        = 32,
                              epochs            = 100,
                              K                 = 12,
                              lookback          = 520,
                              cls_horizons      = c(1, 4, 8, 12),
                              low_q             = 0.33,
                              mid_q             = 0.60,
                              high_q            = 0.85,
                              use_class_balance = FALSE,
                              oversample_factor = 8,
                              minority_class    = "Sell") {
  
  cat("\n", strrep("=", 60), "\n", sep = "")
  cat("DATASET:", dataset_name, "\n")
  cat(sprintf("Thresholds: low=%.0f%% mid=%.0f%% high=%.0f%% | balance=%s | CCE\n",
              low_q*100, mid_q*100, high_q*100,
              ifelse(use_class_balance, "ON", "OFF")))
  cat(strrep("=", 60), "\n")
  
  is_mat     <- is.matrix(series_or_mat) || is.data.frame(series_or_mat)
  n          <- if (is_mat) nrow(series_or_mat) else length(series_or_mat)
  n_features <- if (is_mat) ncol(series_or_mat) else 1
  ent_sig    <- if (is_mat) as.numeric(series_or_mat[, "H"]) else series_or_mat
  
  train_end  <- floor(n * train_frac)
  test_start <- train_end + 1
  
  cat("n =", n, "| train:", train_end, "| test:", n - train_end, "\n")
  
  norm_res <- normalize_series(ent_sig, train_end)
  x_mean   <- norm_res$mean
  x_sd     <- norm_res$sd
  
  if (is_mat) {
    fm <- colMeans(series_or_mat[1:train_end, ], na.rm = TRUE)
    fs <- apply(series_or_mat[1:train_end, ], 2, sd, na.rm = TRUE)
    fs[fs == 0] <- 1
    nm <- sweep(as.matrix(series_or_mat), 2, fm, "-")
    nm <- sweep(nm, 2, fs, "/")
  } else {
    nm <- matrix(norm_res$x_norm, ncol = 1)
  }
  
  ne_full    <- (ent_sig - x_mean) / x_sd
  target_mat <- build_target_matrix(ne_full, K)
  train_idx  <- (lookback + 1):train_end
  test_idx   <- test_start:max(which(complete.cases(target_mat)))
  
  if (length(test_idx) < 2) { cat("ERROR: insufficient test obs\n"); return(NULL) }
  
  tr      <- build_3d_sequences(nm, target_mat, train_idx, lookback)
  te      <- build_3d_sequences(nm, target_mat, test_idx,  lookback)
  X_train <- tr$X;  Y_train_reg <- tr$Y
  X_test  <- te$X;  Y_test_reg  <- te$Y
  
  low_thresh  <- quantile(ent_sig[train_idx], low_q,  na.rm = TRUE)
  mid_thresh  <- quantile(ent_sig[train_idx], mid_q,  na.rm = TRUE)
  high_thresh <- quantile(ent_sig[train_idx], high_q, na.rm = TRUE)
  
# ---- One-hot targets (4-class) -----------------------------------------------
  
  Y_train_entropy <- Y_train_reg[, 1] * x_sd + x_mean
  Y_test_entropy  <- Y_test_reg[,  1] * x_sd + x_mean
  Y_train_onehot  <- entropy_to_onehot(Y_train_entropy,
                                       low_thresh, mid_thresh, high_thresh)
  Y_test_onehot   <- entropy_to_onehot(Y_test_entropy,
                                       low_thresh, mid_thresh, high_thresh)
  
  sample_weights <- NULL
  
  if (use_class_balance) {
    aug     <- oversample_minority_sequences(
      X_train, Y_train_reg, x_mean, x_sd,
      low_thresh, mid_thresh, high_thresh,
      minority_class, oversample_factor)
    X_train <- aug$X
    Y_train_aug_entropy <- aug$Y[, 1] * x_sd + x_mean
    Y_train_onehot      <- entropy_to_onehot(Y_train_aug_entropy,
                                             low_thresh, mid_thresh, high_thresh)
    sample_weights <- compute_sample_weights(
      aug$Y, x_mean, x_sd, low_thresh, mid_thresh, high_thresh)
  }
  
  cat("X_train:", paste(dim(X_train), collapse = "x"),
      "| X_test:", paste(dim(X_test), collapse = "x"), "\n")
  
# ---- Build and train LSTM (4-class output) -----------------------
  model   <- build_mdn_model(lookback, n_features, K)
  history <- model %>% fit(
    x               = X_train,
    y               = Y_train_onehot,
    epochs          = epochs,
    batch_size      = batch_size,
    validation_data = list(X_test, Y_test_onehot),
    callbacks       = standard_callbacks(verbose = 1),
    sample_weight   = sample_weights,
    verbose         = 1
  )
  
  cat("Stopped at epoch:", length(history$metrics$loss), "\n")
  
# ---- Predict softmax output (n_test x 4) -------------------------------------
  softmax_pred <- model %>% predict(X_test)
  colnames(softmax_pred) <- c("Converging", "Transitional", "Diverging", "Perturbation")
  
# ---- Regression diagnostics via class-center (mean) mapping ------------------
  
  class_centers <- c(
    Converging   = mean(ent_sig[train_idx][
      ent_sig[train_idx] <= low_thresh], na.rm = TRUE),
    Transitional = mean(ent_sig[train_idx][
      ent_sig[train_idx] > low_thresh &
        ent_sig[train_idx] <= mid_thresh], na.rm = TRUE),
    Diverging    = mean(ent_sig[train_idx][
      ent_sig[train_idx] > mid_thresh &
        ent_sig[train_idx] < high_thresh], na.rm = TRUE),
    Sell         = mean(ent_sig[train_idx][
      ent_sig[train_idx] >= high_thresh], na.rm = TRUE)
  )
  
  pred_class_idx <- apply(softmax_pred, 1, which.max)
  pred_entropy   <- class_centers[pred_class_idx]
  Y_pred_matrix  <- matrix(rep((pred_entropy - x_mean) / x_sd, K),
                           nrow = length(pred_entropy), ncol = K)
  valid_test_idx <- test_idx[test_idx - lookback + 1 >= 1]
  
  reg_metrics <- compute_regression_metrics(
    Y_pred_matrix, Y_test_reg, ent_sig, valid_test_idx,
    x_mean, x_sd, K, lookback)
  
  cat("\nMAE by horizon (LSTM | Persistence):\n")
  for (k in 1:K)
    cat(sprintf("  k=%2d: %.4f | %.4f  skill=%.4f\n", k,
                reg_metrics$mae_lstm[k], reg_metrics$mae_persist[k],
                reg_metrics$skill[k]))
  
  cls_results <- compute_classification_metrics(
    reg_metrics, ent_sig[1:train_end], cls_horizons, low_q, mid_q, high_q)
  
  print_classification_summary(cls_results, dataset_name)
  
  for (res in cls_results) {
    if (!is.null(res$note)) next
    cat(sprintf("--- k=%d detail ---\n", res$k))
    cat("Confusion matrix:\n");     print(res$conf_matrix)
    cat("\nPrecision per class:\n"); print(res$precision)
    cat("Recall per class:\n");     print(res$recall)
    cat("F1 per class:\n");         print(res$f1_per_class)
    cat("\n")
  }
  
  plot_full_results(history, reg_metrics, cls_results, dataset_name, K)
  print(plot_calibration(reg_metrics, dataset_name))
  
  list(dataset_name = dataset_name,
       reg_metrics  = reg_metrics,
       cls_results  = cls_results,
       history      = history,
       model        = model,
       softmax_pred = softmax_pred,
       low_thresh   = low_thresh,
       mid_thresh   = mid_thresh,
       high_thresh  = high_thresh,
       test_idx     = valid_test_idx,
       train_end    = train_end,
       x_mean       = x_mean,
       x_sd         = x_sd)
}

