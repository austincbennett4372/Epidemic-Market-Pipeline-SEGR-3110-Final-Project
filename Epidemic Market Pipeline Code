load_who_gho_weekly <- function(indicator_code, disease_name) {
  tryCatch({
    url  <- paste0("https://ghoapi.azureedge.net/api/", indicator_code)
    resp <- httr::GET(url, httr::timeout(60))
    if (httr::status_code(resp) != 200)
      stop("HTTP ", httr::status_code(resp), " for ", indicator_code)
    
    raw <- jsonlite::fromJSON(
      httr::content(resp, as = "text", encoding = "UTF-8"), flatten = TRUE
    )
    
    df <- as_tibble(raw$value) %>%
      filter(SpatialDim %in% c("GLOBAL","WLD","TOTL","") | is.na(SpatialDim)) %>%
      filter(grepl("^[0-9]{4}$", as.character(TimeDim))) %>%
      transmute(Date = as.Date(paste0(TimeDim, "-12-31")),
                cases = as.numeric(NumericValue)) %>%
      drop_na(Date, cases) %>%
      arrange(Date) %>%
      group_by(Date) %>%
      summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop")
    
    if (nrow(df) < 5) stop("Too few rows: ", indicator_code)
    
    clean_covid_style_growth(df, date_col = "Date", cases_col = "cases") %>%
      mutate(disease = disease_name)
  }, error = function(e) {
    message("Skipping ", disease_name, ": ", e$message)
    NULL
  })
}

load_cdc_wonder_weekly <- function(disease_code, disease_name) {
