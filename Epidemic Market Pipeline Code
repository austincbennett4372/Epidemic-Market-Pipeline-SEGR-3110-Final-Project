# ---- Find optimal tau and embedding dim (m) for a series ---------------------
embedding_calibration <- function(x, series_name = "series", lag_max = 100,
                                  max_em_dim = 100, do_plot = TRUE) {
  
  x <- as.numeric(x)
  x <- x[!is.na(x)]
  
# ---- Optimal time delay via average mutual information (AMI) [First local minimum]
  
  tau_opt <- tryCatch(
    nonlinearTseries::timeLag(x, technique = "ami",
                              lag.max = lag_max, do.plot = do_plot),
    error = function(e) {
      
      cat("\nAMI failed for", series_name, "- falling back to ACF\n")
      nonlinearTseries::timeLag(x, technique = "acf", lag.max = lag_max,
                                do.plot = do_plot)
    }
  )
# ---- Cao's Method to find the ideal embedding dimension ----------------------
  
  m_opt <- tryCatch(
    nonlinearTseries::estimateEmbeddingDim(x, time.lag = tau_opt, max.embedding.dim = max_em_dim,
                                           do.plot = do_plot),
    error = function(e) {
      cat("\nCao's method failed for", series_name, "- defaulting to m=3\n")
      3L
    }
  )
  
  cat(sprintf("\n %-30s tau_opt = %3d | m_opt = %2d\n",
              series_name, tau_opt, m_opt))
  
  list(tau = tau_opt, m = m_opt, n = length(x))
} 

