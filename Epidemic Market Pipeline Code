# =============================================================================
# Section 1: NaNs to 0
# =============================================================================

trans_matrix[is.na(trans_matrix)] <- 0

# Inspect Dims

n <- nrow(trans_matrix)

print(dim(trans_matrix))


# =============================================================================
# Section 2: Sanity Check for Negative Entries
# =============================================================================

if (any(trans_matrix < 0)) {
  
  stop("Matrix contains negative values; Probabilities cannot be negative.")
}


# =============================================================================
# Section 3: Row - normalize to create transition probability matrix P 
# =============================================================================

row_totals <- rowSums(trans_matrix)

P <- trans_matrix

for (i in 1:n) {
  
  if (row_totals[i] > 0) {
    
    P[i, ] <- trans_matrix[i, ] / row_totals[i]
  } else {
    warning(paste("Row", i, "sums to 0; leaviing row as all zeros."))
    P[i, ] <- rep(0, n)
  }
}

# =============================================================================
# Section 4: Validation
# =============================================================================

print(P)

print(rowSums(P))

P_rounded <- round(P, 3)

P_rounded_df <- data.frame(P_rounded)

print(P_rounded)

# =============================================================================
# Section 5: Stationary Distribution
# =============================================================================

# ---- Solve: pi * P = pi, with sum(pi) = 1 ------------------------------------

A <- t(P) - diag(n)
A[n, ] <- rep(1, n)
b <- c(rep(0, n - 1), 1)

pi_vec <- solve(A, b)

print(round(pi_vec, 4))
print(sum(pi_vec))

# =============================================================================
# Section 6: Vector Bridge - Market Signaling Approximation - 4x4 Matrix
# =============================================================================

groups <- c("Buy", "Hold", "Watch", "Sell")

group_map <- c(
  "Buy", "Buy", "Buy", "Buy",
  "Hold", "Hold", "Hold", "Hold",
  "Watch", "Watch", "Watch", "Watch",
  "Sell"
)
P4_4 <- matrix(0, 4, 4, dimnames = list(groups, groups))

for (a in 1:4) {
  
  rows_in_a <- which(group_map == groups[a])
  denom <- sum(pi_vec[rows_in_a])
  
  for (b in 1:4) {
    
    cols_in_b <- which(group_map == groups[b])
    
    num <- 0
    for (i in rows_in_a) {
      
      num <- num + pi_vec[i] * sum(P[i, cols_in_b])
      
    }
    
    if (denom ==0) {
      warning(paste("Group", groups[a], "has zero stationary mass"))
      next
    }
    P4_4[a, b] <- num / denom
  }
}

print(round(P4_4, 3))
print(rowSums(P4_4))

