# ---- Oversample for minority sequences ---------------------------------------

oversample_minority_sequences <- function(X_train, Y_train,
                                          x_mean, x_sd,
                                          low_thresh, mid_thresh, high_thresh,
                                          minority_class    = "Perturbation",
                                          oversample_factor = 3) {
  k1_targets   <- Y_train[, 1] * x_sd + x_mean
  classes      <- entropy_to_regime(k1_targets, low_thresh, mid_thresh, high_thresh)
  minority_idx <- which(classes == minority_class)
  
  cat("\nMinority class '", minority_class, "': ",
      length(minority_idx), " sequences before oversampling\n", sep = "")
  
  if (length(minority_idx) == 0) {
    cat("No minority sequences found — skipping oversampling\n")
    return(list(X = X_train, Y = Y_train))
  }
  
  X_min    <- X_train[minority_idx, , , drop = FALSE]
  Y_min    <- Y_train[minority_idx, ,  drop = FALSE]
  X_copies <- replicate(oversample_factor, X_min, simplify = FALSE)
  Y_copies <- replicate(oversample_factor, Y_min, simplify = FALSE)
  
  X_aug <- abind(c(list(X_train), X_copies), along = 1)
  Y_aug <- do.call(rbind, c(list(Y_train), Y_copies))
  
  cat("After oversampling: ", nrow(X_aug),
      " sequences (was ", nrow(X_train), ")\n", sep = "")
  
  set.seed(1296)
  idx <- sample(nrow(X_aug))
  list(X = X_aug[idx, , , drop = FALSE],
       Y = Y_aug[idx, ,  drop = FALSE])
}

# ---- Computation of sample weights -------------------------------------------

compute_sample_weights <- function(Y_train, x_mean, x_sd,
                                   low_thresh, mid_thresh, high_thresh) {
  k1_targets <- Y_train[, 1] * x_sd + x_mean
  classes    <- entropy_to_regime(k1_targets, low_thresh, mid_thresh, high_thresh)
  counts     <- table(classes)
  n_total    <- length(classes)
  
  cat("\nAugmented training class distribution:\n")
  print(counts)
  cat("Proportions:\n")
  print(round(prop.table(counts), 4))
  
  # 4 classes now
  wt_map         <- n_total / (4 * counts)
  sample_weights <- as.numeric(wt_map[classes])
  sample_weights[is.na(sample_weights)] <- 1.0
  
  cat("\nInverse-frequency class weights:\n")
  print(round(wt_map, 4))
  
  sample_weights
}

