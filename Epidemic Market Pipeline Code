    dir.create(tmp_dir)
    
    download.file(
      "https://github.com/OpenDengue/master-repo/raw/main/data/releases/V1.3/National_extract_V1_3.zip",
      destfile = tmp_zip, mode = "wb", quiet = TRUE
    )
