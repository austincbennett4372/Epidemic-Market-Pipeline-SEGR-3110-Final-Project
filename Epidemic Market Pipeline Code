compute_transition_plot_data <- function(n_test,
                                         test_orig_indices,
                                         k_horizons,
                                         soft_assign,
                                         T_mat,
                                         comp_map,
                                         lstm_softmax_pred,   # n_test x 4 matrix
                                         H_train,
                                         low_thresh,
                                         mid_thresh,
                                         high_thresh) {
  rows <- list()
  regime_names <- c("Converging", "Transitional", "Diverging", "Perturbation")
  
  for (i in seq_len(n_test)) {
    orig_t <- test_orig_indices[i]
    if (orig_t > nrow(soft_assign)) next
    
    for (k in k_horizons) {
      sw <- lstm_softmax_pred[i, ]
      if (any(is.na(sw))) next
      names(sw) <- regime_names
      
      result <- compute_posterior_softmax(
        t            = orig_t,
        k_horizon    = k,
        soft_assign  = soft_assign,
        T_mat        = T_mat,
        comp_map     = comp_map,
        lstm_softmax = sw
      )
      
      for (regime in regime_names) {
        rows[[length(rows) + 1]] <- data.frame(
          test_row   = i,
          orig_t     = orig_t,
          k          = k,
          regime     = regime,
          prior      = result$prior[regime],
          likelihood = result$likelihood[regime],
          posterior  = result$posterior[regime],
          stringsAsFactors = FALSE
        )
      }
    }
  }
  bind_rows(rows)
}

# ---- Plot bayesian heatmap (4-class) -----------------------------------------
plot_bayesian_heatmap <- function(plot_data, k_horizon = 8,
                                  n_top = 4, date_vec = NULL) {
  top_t <- plot_data %>%
    dplyr::filter(k == k_horizon) %>%
    dplyr::group_by(test_row) %>%
    dplyr::summarise(divergence = sum(abs(posterior - prior)), .groups = "drop") %>%
    dplyr::arrange(desc(divergence)) %>%
    dplyr::slice_head(n = n_top) %>%
    dplyr::pull(test_row)
  
  pd <- plot_data %>%
    dplyr::filter(k == k_horizon, test_row %in% top_t) %>%
    tidyr::pivot_longer(cols      = c(prior, likelihood, posterior),
                        names_to  = "stage",
                        values_to = "probability") %>%
    dplyr::mutate(
      stage = factor(stage,
                     levels = c("prior", "likelihood", "posterior"),
                     labels = c("01  Markov Prior",
