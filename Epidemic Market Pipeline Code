    raw <- read_csv(csv_f[pick], show_col_types = FALSE)
    stopifnot(all(c("calendar_end_date", "dengue_total") %in% names(raw)))
    
    raw %>%
      transmute(Date = as.Date(calendar_end_date), cases = as.numeric(dengue_total)) %>%
      group_by(Date) %>%
      summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop") %>%
      { clean_covid_style_growth(., date_col = "Date", cases_col = "cases") } %>%
      mutate(disease = "DENGUE_GLOBAL")
  }, error = function(e) {
    message("Skipping DENGUE_GLOBAL: ", e$message)
    NULL
  })
}

