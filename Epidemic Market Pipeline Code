to_week_end_sat <- function(d) {
  d <- as.Date(d)
  d + ((6L - wday(d, week_start = 1L)) %% 7L)
}

shannon_entropy <- function(x, bins = 20) {
  x <- x[is.finite(x)]
  if (length(x) < 10) return(NA_real_)
  h <- hist(x, breaks = bins, plot = FALSE)
  p <- h$counts / sum(h$counts)
  p <- p[p > 0]
  -sum(p * log(p))
}

acf1 <- function(x) {
  x <- x[is.finite(x)]
  if (length(x) < 10) return(NA_real_)
  as.numeric(acf(x, plot = FALSE, lag.max = 1)$acf[2])
}

window_features <- function(x) {
  x <- x[is.finite(x)]
  if (length(x) < 10)
    return(c(mean=NA_real_, sd=NA_real_, acf1=NA_real_,
             skew=NA_real_, kurt=NA_real_, ent=NA_real_,
             ent_sq=NA_real_, sd_ent=NA_real_))
  
  ent_val <- shannon_entropy(x, bins = 20)
  sd_val  <- sd(x)
  
  c(mean=mean(x), sd=sd(x), acf1=acf1(x),
    skew=moments::skewness(x), kurt=moments::kurtosis(x),
    ent=ent_val,
    ent_sq=ent_val^2,
    sd_ent=sd_val * ent_val)
}

roll_feature_df <- function(df, signal_col, win = 520, prefix = "") {
  sig <- df[[signal_col]]
  feats <- zoo::rollapply(sig, width = win, FUN = window_features,
                          by.column = FALSE, align = "right")
  feats <- as.data.frame(feats)
  colnames(feats) <- paste0(prefix, colnames(feats))
  feats$Date <- df$Date[win:nrow(df)]
  feats %>% relocate(Date)
}

clean_covid_style_growth <- function(df, date_col = "Date", cases_col = "cases") {
  df <- df %>%
    mutate(Date  = as.Date(.data[[date_col]]),
           cases = as.numeric(.data[[cases_col]])) %>%
    arrange(Date) %>% drop_na(Date) %>%
    mutate(Date = to_week_end_sat(Date)) %>%
    group_by(Date) %>%
    summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop") %>%
    arrange(Date)
  
  all_weeks <- tibble(Date = seq(min(df$Date), max(df$Date), by = "week"))
  
  left_join(all_weeks, df, by = "Date") %>%
    arrange(Date) %>%
    mutate(cases = zoo::na.approx(cases, na.rm = FALSE),
           cases = zoo::na.locf(cases, na.rm = FALSE),
           cases = zoo::na.locf(cases, fromLast = TRUE, na.rm = FALSE),
           cases = as.numeric(cases)) %>%
    drop_na(cases) %>%
    filter(cases != 0) %>%
    mutate(growth = log(cases) - log(lag(cases))) %>%
    filter(is.finite(growth), growth != 0) %>%
    select(Date, cases, growth)
}

