# =============================================================================
# SECTION 6: Regime classification via Bayesian Updating (4-class)

# Note: 
# The softmax likelihood 4-dimensional:
#   Prior      = k-step Markov prior from 4x4 transition matrix
#   Likelihood = LSTM softmax P(Conv/Trans/Div/Pert)
#   Posterior  = prior * likelihood, normalized
# =============================================================================

matrix_power <- function(M, k) {
  result <- diag(nrow(M))
  for (i in seq_len(k)) result <- result %*% M
  result
}

# ---- GMM Clusters (Component) to regime map  ---------------------------------
# ---- 4 market signals: Buy / Watch / Hold / Sell -----------------------------

component_to_regime_map <- function(gmm_clustered) {
  gmm_clustered %>%
    dplyr::group_by(cluster, trading_regime) %>%
    dplyr::summarise(n = n(), .groups = "drop") %>%
    dplyr::group_by(cluster) %>%
    dplyr::slice_max(n, n = 1, with_ties = FALSE) %>%
    dplyr::ungroup() %>%
    dplyr::select(cluster, regime = trading_regime) %>%
    dplyr::arrange(cluster)
}

# ---- Compute the posterior softmax (4-class) ---------------------------------
# ---- lstm_softmax corresponds to a named vector:
# ---- c(Converging=p1, Transitional=p2, Diverging=p3, Perturbation=p4) --------

compute_posterior_softmax <- function(t, k_horizon, soft_assign, T_mat,
                                      comp_map, lstm_softmax) {

  current_state <- as.numeric(soft_assign[t, ])
  T_k           <- matrix_power(T_mat, k_horizon)
  markov_dist   <- current_state %*% T_k
  
  prior <- c(
    Converging   = sum(markov_dist[comp_map$regime == "Buy"]),
    Transitional = sum(markov_dist[comp_map$regime == "Watch"]),
    Diverging    = sum(markov_dist[comp_map$regime == "Hold"]),
    Perturbation = sum(markov_dist[comp_map$regime == "Sell"])
  )
  prior <- prior / sum(prior)
  
  likelihood <- lstm_softmax / sum(lstm_softmax)
  
  unnorm    <- prior * likelihood
  denom     <- sum(unnorm)
  posterior <- if (denom == 0 || is.na(denom)) prior else unnorm / denom
  
  list(prior      = prior,
       likelihood = likelihood,
       posterior  = posterior)
}

