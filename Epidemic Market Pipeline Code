cat("\n--- VALIDITY VERDICTS ---\n")
check_valid <- function(res, name) {
  if (is.null(res)) { cat(name, ": SKIPPED\n"); return(FALSE) }
  k4_skill <- res$reg_metrics$skill[4]
  k1_cls   <- res$cls_results[["k1"]]
  k1_acc   <- if (!is.null(k1_cls) && is.null(k1_cls$note)) k1_cls$accuracy else NA
  pass_reg <- k4_skill > 0
  pass_cls <- !is.na(k1_acc) && k1_acc > 0.25   # ← 4-class baseline
  cat(sprintf("%-50s skill k=4: %6.4f [%s] | acc k=1: %s [%s]\n",
              name, k4_skill, ifelse(pass_reg, "PASS", "FAIL"),
              ifelse(is.na(k1_acc), "NA", round(k1_acc, 4)),
              ifelse(pass_cls, "PASS", "FAIL")))
  pass_reg && pass_cls
}

