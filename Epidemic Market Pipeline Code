normalize_series <- function(x, train_end_idx) {
  m <- mean(x[1:train_end_idx], na.rm = TRUE)
  s <- sd(x[1:train_end_idx],   na.rm = TRUE)
  if (s == 0) s <- 1
  list(x_norm = (x - m) / s, mean = m, sd = s)
}

build_target_matrix <- function(x, K) {
  n   <- length(x)
  mat <- matrix(NA, nrow = n, ncol = K)
  colnames(mat) <- paste0("k", 1:K)
  for (k in 1:K) mat[1:(n - k), k] <- x[(1 + k):n]
  mat
}

build_3d_sequences <- function(x_or_mat, target_mat, indices, lookback) {
  feat_mat   <- if (is.vector(x_or_mat)) matrix(x_or_mat, ncol = 1) else as.matrix(x_or_mat)
  n_features <- ncol(feat_mat)
  K          <- ncol(target_mat)
  n_samples  <- length(indices)
  X          <- array(0, dim = c(n_samples, lookback, n_features))
  Y          <- matrix(0, nrow = n_samples, ncol = K)
  valid      <- 0
  for (i in seq_along(indices)) {
    t       <- indices[i]
    t_start <- t - lookback + 1
    if (t_start < 1) next
    valid        <- valid + 1
    X[valid, , ] <- feat_mat[t_start:t, , drop = FALSE]
    Y[valid, ]   <- target_mat[t, ]
  }
  list(X = X[1:valid, , , drop = FALSE],
       Y = Y[1:valid, ,  drop = FALSE])
}

# ==============================================================================
# SECTION 3: Entropy to regime mapping
# ==============================================================================

entropy_to_regime <- function(x, low_thresh, mid_thresh, high_thresh) {
  dplyr::case_when(
    x <= low_thresh                          ~ "Converging",
    x >  low_thresh & x <= mid_thresh        ~ "Transitional",
    x >  mid_thresh & x <  high_thresh       ~ "Diverging",
    x >= high_thresh                         ~ "Perturbation",
    TRUE                                     ~ "Transitional"  # Safety fallback
  )
}

# ---- entropy to onehot encoding (4-class) ------------------------------------

# Column order: Converging=1, Transitional=2, Diverging=3, Perturbation=4

entropy_to_onehot <- function(x, low_thresh, mid_thresh, high_thresh) {
  classes <- entropy_to_regime(x, low_thresh, mid_thresh, high_thresh)
  mat     <- matrix(0, nrow = length(classes), ncol = 4)
  colnames(mat) <- c("Converging", "Transitional", "Diverging", "Perturbation")
  mat[classes == "Converging",   1] <- 1
  mat[classes == "Transitional", 2] <- 1
  mat[classes == "Diverging",    3] <- 1
  mat[classes == "Perturbation", 4] <- 1
  mat
}

