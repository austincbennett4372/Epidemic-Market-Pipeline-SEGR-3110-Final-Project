mackey_glass <- function(n_points = 2000, tau = 17, beta = 0.2,
                         gamma = 0.1, n_exp = 10) {
  x        <- rep(0.9, n_points + tau)
  x[1:tau] <- x[1:tau] + rnorm(tau, 0, 0.01)
  for (t in (tau + 1):(n_points + tau)) {
    x_d  <- x[t - tau]
    x[t] <- x[t - 1] + beta * x_d / (1 + x_d^n_exp) - gamma * x[t - 1]
  }
  x[(tau + 1):(n_points + tau)]
}

