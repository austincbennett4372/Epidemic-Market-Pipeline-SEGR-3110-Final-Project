run_svm_for_one_disease_djia <- function(one_disease_name) {
  den    <- disease_df %>% filter(disease == one_disease_name) %>% select(Date, cases, growth)
  paired <- inner_join(djia_weekly, den, by = "Date") %>% arrange(Date)
  if (nrow(paired) < 60) { warning("DJIA too few rows: ", one_disease_name); return(NULL) }
  
  djia_feat_r <- roll_feature_df(paired, "ret",    win = WIN_WEEKLY, prefix = "m_")
  dis_feat_r  <- roll_feature_df(paired, "growth", win = WIN_WEEKLY, prefix = "d_")
  
  paired_labeled <- paired %>%
    mutate(ret_next = lead(ret), y = if_else(ret_next > 0, 1L, 0L)) %>%
    drop_na(ret_next, y)
  
  feats <- inner_join(djia_feat_r, dis_feat_r, by = "Date") %>%
    inner_join(paired_labeled %>% select(Date, ret_next, y), by = "Date") %>%
    drop_na() %>%
    arrange(Date) %>%
    mutate(
      m_d_ent_interaction = m_ent * d_ent,
      ent_ratio           = d_ent / (m_ent + 0.001),
      acf1_difference     = abs(m_acf1 - d_acf1),
      volatility_sync     = abs(m_sd - d_sd)
    )
  
  if (nrow(feats) < 200) { warning("DJIA too few feature rows: ", one_disease_name); return(NULL) }
  
  base_feat_cols   <- c(paste0("m_", feat_cols), paste0("d_", feat_cols))
  interaction_cols <- c("m_d_ent_interaction", "ent_ratio", "acf1_difference", "volatility_sync")
  full_feat_cols   <- c(base_feat_cols, interaction_cols)
  djia_only_cols   <- grep("^m_", names(feats), value = TRUE)
  
  n       <- nrow(feats)
  cut_idx <- floor(0.75 * n)
  train_f <- feats[1:cut_idx, ]
  test_f  <- feats[(cut_idx + 1):n, ]
  
  train_x <- scale(train_f[, full_feat_cols])
  test_x  <- scale(test_f[, full_feat_cols],
                   center = attr(train_x, "scaled:center"),
                   scale  = attr(train_x, "scaled:scale"))
  
  train_y <- factor(train_f$y)
  test_y  <- factor(test_f$y)
  
  class_dist <- table(train_y)
  weight_0   <- as.numeric(class_dist["1"] / class_dist["0"])
  weight_1   <- 1.0
  if (min(class_dist) / max(class_dist) < 0.3) weight_0 <- weight_0 * 1.5
  
  cat("  [DJIA]", one_disease_name, "- weights: 0=", round(weight_0, 2), "1=", round(weight_1, 2), "\n")
  
  tuned <- e1071::tune.svm(
    x = train_x, y = train_y, kernel = "radial",
    gamma = 2^seq(-5, -1, by = 1),
    cost  = 2^seq(-1,  5, by = 1),
    class.weights = c("0" = weight_0, "1" = weight_1),
    probability   = TRUE,
    tunecontrol = tune.control(cross = 5)
  )
  best       <- tuned$best.model
  best_gamma <- tuned$best.parameters$gamma
  best_cost  <- tuned$best.parameters$cost
  
  pred <- predict(best, test_x)
  cm   <- table(Pred = pred, True = test_y)
  acc  <- sum(as.character(pred) == as.character(test_y)) / length(test_y)
  
  baseline_buy_acc <- mean(test_f$y == 1)
  
  djia_col_idx  <- which(full_feat_cols %in% djia_only_cols)
  mdl_djia_only <- e1071::svm(
    x      = train_x[, djia_col_idx, drop = FALSE],
    y      = train_y,
    kernel = "radial",
    cost   = best_cost,
    gamma  = best_gamma,
    scale  = FALSE
  )
  acc_djia_only <- sum(
    as.character(predict(mdl_djia_only, test_x[, djia_col_idx, drop = FALSE])) ==
      as.character(test_y)
  ) / length(test_y)
  
  wf_accs <- walk_forward_svm(feats, full_feat_cols, step = 20, min_train = 150,
                              cost = best_cost, gamma = best_gamma)
  
  full_x <- scale(feats[, full_feat_cols],
                  center = attr(train_x, "scaled:center"),
                  scale  = attr(train_x, "scaled:scale"))
  feats$pred <- as.integer(as.character(predict(best, full_x)))
  
  strat_df <- test_f %>%
    select(Date, ret_next, y) %>%
    mutate(
      pred      = as.integer(as.character(predict(best, test_x))),
      strat_ret = if_else(pred == 1L, ret_next, 0),
      cum_strat = cumsum(strat_ret),
      cum_bnh   = cumsum(ret_next)
    )
  
  list(
    disease         = one_disease_name,
    index           = "DJIA",
    acc             = acc,
    acc_djia_only   = acc_djia_only,
    acc_idx_only    = acc_djia_only,
    baseline_buy    = baseline_buy_acc,
    wf_accs         = wf_accs,
    wf_mean         = mean(wf_accs),
    wf_sd           = sd(wf_accs),
    cm              = cm,
    params          = tuned$best.parameters,
    feats           = feats,
    strat_df        = strat_df,
    paired          = paired,
    full_feat_cols  = full_feat_cols,
    train_x         = train_x,
    train_f         = train_f,
    test_f          = test_f,
    test_x          = test_x,
    train_y         = train_y,
    test_y          = test_y
  )
}

