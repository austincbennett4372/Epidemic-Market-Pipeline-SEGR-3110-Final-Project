    "Transitional" = c("#E8F4FB", "#2980B9"),   # blue   → Watch
    "Diverging"    = c("#FAEEDA", "#BA7517"),   # amber  → Hold
    "Perturbation" = c("#FAECE7", "#D85A30")    # red    → Sell
  )
  
  pd <- pd %>%
    dplyr::rowwise() %>%
    dplyr::mutate(
      fill_hex = {
        pal  <- fill_palettes[[as.character(regime)]]
        ramp <- colorRampPalette(pal)
        ramp(101)[round(probability * 100) + 1]
      }
    ) %>%
    dplyr::ungroup()
  
  ggplot(pd, aes(x = regime, y = t_label, fill = fill_hex)) +
    geom_tile(color = "grey20", linewidth = 0.4) +
    geom_text(aes(label = scales::percent(probability, accuracy = 1)),
              size = 3.2, color = "white", fontface = "bold") +
    scale_fill_identity() +
    facet_wrap(~stage, ncol = 3) +
    labs(
      title    = paste0("Bayesian regime update — k=", k_horizon, " horizon"),
      subtitle = paste0("Rows = top ", n_top,
                        " time points by prior-posterior divergence  |  ",
                        "Conv=Buy · Trans=Watch · Div=Hold · Pert=Sell"),
      x = "Regime at t+k",
      y = NULL
    ) +
    theme_dark() +
    theme(
      strip.text    = element_text(size = 9,  color = "white", face = "bold"),
      axis.text.x   = element_text(size = 8,  color = "grey70"),
      axis.text.y   = element_text(size = 8,  color = "grey70"),
      axis.ticks    = element_blank(),
      panel.grid    = element_blank(),
      panel.spacing = unit(1.2, "lines"),
