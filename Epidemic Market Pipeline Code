            "neglected_tropical_diseases/neglected_tropical_diseases.csv"
          ),
          show_col_types = FALSE
        )
        cat("OWID NTD columns:", paste(names(raw3), collapse = ", "), "\n")
        
        chagas_cols <- grep("chagas|trypanosoma", names(raw3),
                            value = TRUE, ignore.case = TRUE)
        if (length(chagas_cols) == 0) stop("No Chagas column in OWID NTD")
        
        date_col3 <- intersect(c("date","Date","year"), names(raw3))[1]
        
        raw3 %>%
          transmute(
            Date = {
              val <- .data[[date_col3]]
              if (all(grepl("^[0-9]{4}$", as.character(na.omit(val))))) {
                as.Date(paste0(val, "-12-31"))
              } else {
                as.Date(val)
              }
            },
            cases = as.numeric(rowSums(select(., all_of(chagas_cols)), na.rm = TRUE))
          ) %>%
          filter(cases > 0) %>%
          group_by(Date) %>%
          summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop") %>%
          arrange(Date) %>%
          clean_covid_style_growth(date_col = "Date", cases_col = "cases") %>%
          mutate(disease = "CHAGAS_LATAM")
      }, error = function(e3) {
        message("Skipping CHAGAS_LATAM -- all sources failed: ", e3$message)
        NULL
      })
    })
  })
}

load_leishmaniasis_weekly <- function() {
  .clean_leish <- function(df) {
    df %>%
      drop_na(Date, cases) %>%
      filter(cases > 0) %>%
      group_by(Date) %>%
      summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop") %>%
      arrange(Date) %>%
      { if (nrow(.) < 5) stop("Too few rows") else . } %>%
      clean_covid_style_growth(date_col = "Date", cases_col = "cases") %>%
      mutate(disease = "LEISH_GLOBAL")
  }
  
  tryCatch({
    message("Leishmaniasis: trying WHO GHO (VL + CL combined)...")
    dfs_collected <- list()
    
    for (code in c("NTD_VL","LEISH_VL_CASES","NTD_CL","LEISH_CL_CASES","NTD_LEISH")) {
      tryCatch({
        resp <- httr::GET(paste0("https://ghoapi.azureedge.net/api/", code),
                          httr::timeout(60))
        if (httr::status_code(resp) != 200) next
        
        raw <- jsonlite::fromJSON(
          httr::content(resp, as = "text", encoding = "UTF-8"),
          flatten = TRUE
        )
        if (length(raw$value) == 0) next
        
        cat("Leish GHO (", code, ") columns:",
            paste(names(raw$value), collapse = ", "), "\n")
        
        df_tmp <- as_tibble(raw$value) %>%
          filter(grepl("^[0-9]{4}$", as.character(TimeDim))) %>%
          transmute(Date = as.Date(paste0(TimeDim, "-12-31")),
                    cases = as.numeric(NumericValue)) %>%
          filter(!is.na(cases), cases > 0)
        
        if (nrow(df_tmp) >= 5) {
          dfs_collected[[code]] <- df_tmp
          message(sprintf("Leish GHO (%s): %d annual rows", code, nrow(df_tmp)))
        }
      }, error = function(e) NULL)
    }
    
    if (length(dfs_collected) == 0) stop("No GHO codes returned data")
    
    combined <- bind_rows(dfs_collected) %>%
      group_by(Date) %>%
      summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop")
    
    result <- .clean_leish(combined)
    message(sprintf("Leishmaniasis GHO combined: %d weekly rows", nrow(result)))
    result
  }, error = function(e1) {
    message("WHO GHO Leish failed (", e1$message, ") -- trying OWID NTD...")
    tryCatch({
      raw2 <- read_csv(
        paste0(
          "https://catalog.ourworldindata.org/garden/who/latest/",
          "neglected_tropical_diseases/neglected_tropical_diseases.csv"
        ),
        show_col_types = FALSE
      )
      cat("OWID NTD columns:", paste(names(raw2), collapse = ", "), "\n")
      
      leish_cols <- grep("leish|kala.azar|visceral",
                         names(raw2), value = TRUE, ignore.case = TRUE)
      if (length(leish_cols) == 0) stop("No Leish column in OWID NTD")
      
      date_col2 <- intersect(c("date","Date","year"), names(raw2))[1]
      
      raw2 %>%
        transmute(
          Date = {
            val <- .data[[date_col2]]
            if (all(grepl("^[0-9]{4}$", as.character(na.omit(val))))) {
              as.Date(paste0(val, "-12-31"))
            } else {
              as.Date(val)
            }
          },
          cases = as.numeric(rowSums(select(., all_of(leish_cols)), na.rm = TRUE))
        ) %>%
        filter(cases > 0) %>%
        group_by(Date) %>%
        summarise(cases = sum(cases, na.rm = TRUE), .groups = "drop") %>%
        arrange(Date) %>%
        clean_covid_style_growth(date_col = "Date", cases_col = "cases") %>%
        mutate(disease = "LEISH_GLOBAL")
    }, error = function(e2) {
      message("Skipping LEISH_GLOBAL -- all sources failed: ", e2$message)
      NULL
    })
  })
}

