v2 <- check_valid(results_real, "Epidemic-market entropy (combined)")
v3 <- check_valid(results_spx,  "Epidemic-market entropy (SPX only)")
v4 <- check_valid(results_djia, "Epidemic-market entropy (DJIA only)")

