# ---- Build model ---------------------------------------------------------

build_mdn_model <- function(lookback, n_features, K) {
  inputs  <- keras_input(shape = c(lookback, n_features))
  outputs <- inputs %>%
    layer_lstm(units = 256, return_sequences = TRUE,
               kernel_regularizer = regularizer_l2(0.010)) %>%    #og: 256
    layer_dropout(rate = 0.15) %>%
    layer_lstm(units = 128, return_sequences = TRUE,    #og: 128
               kernel_regularizer = regularizer_l2(0.010)) %>%
    layer_dropout(rate = 0.15) %>%
    layer_lstm(units = 64, return_sequences = FALSE,    # 64
               kernel_regularizer = regularizer_l2(0.010)) %>%
    layer_dropout(rate = 0.15) %>%
    layer_dense(units = 16, activation = "leaky_relu",    #og: 8
                kernel_regularizer = regularizer_l2(0.010)) %>%
    layer_dense(units = 4L, activation = "softmax")   # ← 4 regime classes
  
  model <- keras_model(inputs = inputs, outputs = outputs)
  
  model %>% compile(
    optimizer = optimizer_nadam(learning_rate = 0.0003, clipnorm = 1.0),
    loss      = loss_categorical_crossentropy(),
    metrics   = list("accuracy", "mae")
  )
}

