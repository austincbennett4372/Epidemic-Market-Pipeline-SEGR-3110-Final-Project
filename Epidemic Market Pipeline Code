compute_regression_metrics <- function(Y_pred_norm, Y_test_norm,
                                       x_orig, test_idx,
                                       x_mean, x_sd, K, lookback) {
  pred    <- Y_pred_norm * x_sd + x_mean
  true    <- Y_test_norm * x_sd + x_mean
  valid_t <- test_idx[test_idx - lookback + 1 >= 1]
  
  mae_lstm <- sapply(1:K, function(k)
    mean(abs(pred[, k] - true[, k]), na.rm = TRUE))
  mae_persist <- sapply(1:K, function(k) {
    mean(abs(x_orig[valid_t] - x_orig[pmin(valid_t + k, length(x_orig))]),
         na.rm = TRUE)
  })
  list(mae_lstm    = mae_lstm,
       mae_persist = mae_persist,
       skill       = 1 - mae_lstm / mae_persist,
       pred        = pred,
       true        = true)
}

# ---- Compute classification Metrics (4-class) ---------------------------------------

compute_classification_metrics <- function(reg_results, x_train,
                                           horizons    = c(1, 4, 8, 12),
                                           low_q       = 0.33,
                                           mid_q       = 0.67,
                                           high_q      = 0.90) {
  low_thresh  <- quantile(x_train, low_q,  na.rm = TRUE)
  mid_thresh  <- quantile(x_train, mid_q,  na.rm = TRUE)
  high_thresh <- quantile(x_train, high_q, na.rm = TRUE)
  
  cat(sprintf("  Thresholds — low (%.0f%%): %.4f | mid (%.0f%%): %.4f | high (%.0f%%): %.4f\n",
              low_q*100, low_thresh, mid_q*100, mid_thresh, high_q*100, high_thresh))
  
  results <- list()
  for (k in horizons) {
    pred_vals <- reg_results$pred[, k]
    true_vals <- reg_results$true[, k]
    valid     <- !is.na(pred_vals) & !is.na(true_vals)
    pred_vals <- pred_vals[valid]
    true_vals <- true_vals[valid]
    
    if (length(pred_vals) < 5) {
      results[[paste0("k", k)]] <- list(k = k, note = "insufficient observations")
      next
    }
    
    lvls <- c("Converging", "Transitional", "Diverging", "Perturbation")
    pred_class <- factor(
      entropy_to_regime(pred_vals, low_thresh, mid_thresh, high_thresh), levels = lvls)
    true_class <- factor(
      entropy_to_regime(true_vals, low_thresh, mid_thresh, high_thresh), levels = lvls)
    
    cm <- tryCatch(caret::confusionMatrix(pred_class, true_class),
                   error = function(e) NULL)
    if (is.null(cm)) {
      results[[paste0("k", k)]] <- list(k = k, note = "confusionMatrix failed")
      next
    }
    
    byclass  <- cm$byClass
    macro_f1 <- mean(byclass[, "F1"], na.rm = TRUE)
    results[[paste0("k", k)]] <- list(
      k            = k,
      accuracy     = round(as.numeric(cm$overall["Accuracy"]), 4),
      macro_f1     = round(macro_f1, 4),
      precision    = round(byclass[, "Precision"], 4),
      recall       = round(byclass[, "Recall"],    4),
      f1_per_class = round(byclass[, "F1"],        4),
      conf_matrix  = cm$table,
      low_thresh   = low_thresh,
      mid_thresh   = mid_thresh,
      high_thresh  = high_thresh
    )
  }
  results
}

